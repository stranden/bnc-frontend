# nginx configuration for the BNC frontend.
#
# Rendered through envsubst at container start; only ${BNC_*} variables are
# substituted (see NGINX_ENVSUBST_FILTER), so nginx's own $host, $uri and
# friends are left intact.

server {
    listen      8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Client uploads are small; keep the limit tight.
    client_max_body_size 2m;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/xml;

    # Basic hardening. No CSP here because it depends on the deployment; add
    # one at the reverse proxy in front if the site is internet-facing.
    add_header X-Content-Type-Options nosniff        always;
    add_header X-Frame-Options        SAMEORIGIN     always;
    add_header Referrer-Policy        same-origin    always;

    # Container-level health probe.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Proxy API calls to the BNC backend so the browser stays same-origin and
    # no CORS configuration is needed on the backend.
    location /api/ {
        proxy_pass         ${BNC_BACKEND_URL}/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";

        # NetBox pushes can be slow when a device is unreachable.
        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
    }

    # Hashed build assets are immutable and safe to cache indefinitely.
    location /assets/ {
        expires 1y;
        add_header Cache-Control          "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Never cache the entry point or the runtime config, otherwise a redeploy
    # would leave browsers on a stale bundle or stale settings.
    location = /index.html {
        add_header Cache-Control          "no-store, must-revalidate";
        add_header X-Content-Type-Options nosniff    always;
        add_header X-Frame-Options        SAMEORIGIN always;
        add_header Referrer-Policy        same-origin always;
    }

    location = /config.js {
        add_header Cache-Control          "no-store, must-revalidate";
        add_header Content-Type           "application/javascript";
        add_header X-Content-Type-Options nosniff always;
    }

    # SPA history-mode fallback: unknown paths render the app, which routes
    # client-side. Without this, refreshing /devices would 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
