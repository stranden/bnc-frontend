# --- BNC backend ---
# Where the BNC backend actually runs. The dev server proxies /api to this
# URL so the browser never talks to it cross-origin; the backend serves
# everything under /api.
VITE_BACKEND_URL=http://localhost:8000

# --- Auth ---
# dev    = accept any credentials locally (no backend auth yet)
# token  = POST /auth/login, store the returned bearer token
# netbox = user supplies their own NetBox API token
VITE_AUTH_PROVIDER=dev

# --- Dev server ---
VITE_PORT=5173
