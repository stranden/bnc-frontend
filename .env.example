# --- BNC backend ---
# Base URL the frontend calls. Leave as /api and set VITE_PROXY_TARGET during
# development so Vite proxies to the backend and avoids CORS entirely.
VITE_API_BASE_URL=/api
# Dev-server proxy target, i.e. where the BNC backend actually runs.
VITE_PROXY_TARGET=http://localhost:8000

# --- Mock transport ---
# true  = every request is served by the built-in mock (no backend needed)
# false = real HTTP, except endpoints the backend does not implement yet
# (see MOCKED_WRITE_ENDPOINTS in src/api/mock/index.ts)
VITE_USE_MOCK=true
# Simulated latency in ms, so loading states are visible.
VITE_MOCK_LATENCY=220
# Seed only one site, to exercise the auto-select-default-site behaviour.
VITE_MOCK_SINGLE_SITE=false

# --- Auth ---
# dev    = accept any credentials locally (no backend auth yet)
# token  = POST /auth/login, store the returned bearer token
# netbox = user supplies their own NetBox API token
VITE_AUTH_PROVIDER=dev

# --- Dev server ---
VITE_PORT=5173
